{
  "title": "Product Service - RED",
  "uid": "product-red",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Rate (requests/sec)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{method}} {{route}}",
          "expr": "sum by (method, route) (rate(http_requests_total[1m]))" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Errors (% non-2xx)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{method}} {{route}}",
          "expr": "100 * sum by (method, route) (rate(http_request_errors_total[1m])) / sum by (method, route) (rate(http_requests_total[1m]))" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Duration p50 / p95 (seconds)",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50 {{method}} {{route}}",
          "expr": "histogram_quantile(0.50, sum by (le, method, route) (rate(http_request_duration_seconds_bucket[1m])))" },
        { "refId": "B", "legendFormat": "p95 {{method}} {{route}}",
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(http_request_duration_seconds_bucket[1m])))" }
      ]
    }
  ]
}
